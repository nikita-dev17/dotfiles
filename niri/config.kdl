input {
    warp-mouse-to-focus mode="center-xy"
    focus-follows-mouse max-scroll-amount="0%"

    keyboard {
        track-layout "window"
        xkb {
            layout "us,ru,ua"
            options "grp:alt_shift_toggle,compose:ralt,ctrl:nocaps"
        }
        numlock
    }

    touchpad {
        tap
        dwt
        drag true
        drag-lock
        natural-scroll
        accel-speed 0.3
        scroll-method "two-finger"
        disabled-on-external-mouse
    }

    mouse {
        accel-speed 0.2
    }
}

output "eDP-1" {
    mode "1920x1080@144.000"
    scale 1
}

layout {
    gaps 16
    center-focused-column "on-overflow"
    // center-focused-column "always"
    // center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
        active-color "#cba6f750"
        inactive-color "#3b3b3b"    
    }

    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {}
}

spawn-at-startup "waybar -c /home/nikita/.config/waybar/niri/config.json -s /home/nikita/.config/waybar/niri/style.css"
spawn-at-startup "swww-daemon"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

binds {
    // overlay
    Mod+Shift+Slash { show-hotkey-overlay; }

    // aps
    Mod+C { spawn "kitty"; }
    Mod+N { spawn "nautilus" "-w"; }
    Mod+T { spawn "Telegram"; }
    Mod+R { spawn "rofi" "-show" "drun"; }
    Mod+B { spawn "firefox"; }
    Mod+G { spawn "firefox" "--new-window" "https://chatgpt.com"; }

    // window
    Mod+Q { close-window; }
    Mod+F { fullscreen-window; }
    Mod+Shift+F { maximize-column; }
    Mod+Space { toggle-window-floating; }

    // Lock
    //Super+L { spawn "swaylock"; }
    
    // media
    XF86AudioRaiseVolume { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }

    XF86AudioPlay { spawn-sh "playerctl play-pause"; }
    XF86AudioNext { spawn-sh "playerctl next"; }
    XF86AudioPrev { spawn-sh "playerctl previous"; }

    XF86MonBrightnessUp { spawn "brightnessctl" "set" "+20%"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "set" "20%-"; }
    
    // overview
    Mod+O { toggle-overview; }

    // focus
    Mod+A { focus-column-left; }
    Mod+S { focus-window-down; }
    Mod+W { focus-window-up; }
    Mod+D { focus-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End { focus-column-last; }

    // move
    Mod+Shift+A { move-column-left; }
    Mod+Shift+S { move-window-down; }
    Mod+Shift+W { move-window-up; }
    Mod+Shift+D { move-column-right; }
    
    Mod+Z { consume-or-expel-window-left; }
    Mod+X { consume-or-expel-window-right; }
    
    // resize
    Mod+Ctrl+A { set-column-width "-10%"; }
    Mod+Ctrl+S { set-window-height "+10%"; }
    Mod+Ctrl+W { set-window-height "-10%"; }
    Mod+Ctrl+D { set-column-width "+10%"; }
    
    // workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; } 

    // move window to workspace
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // tabbled
    Mod+Tab { toggle-column-tabbed-display; }
    
    // screenshots
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    
    // system
    // mod+escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}
